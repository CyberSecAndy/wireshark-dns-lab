# .gitignore for Wireshark DNS Lab

# Wireshark/tcpdump capture files (temporary, not tracking captures)
*.pcap
*.pcapng
*.cap
*.dmp

# Personal pcap files (backup or working files)
captures/
backups/
*.pcap~
*.pcapng~

# OS-specific files
.DS_Store
Thumbs.db
.windows-build-helpers/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.vscode/
.vim/
*.vim

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Node
node_modules/
npm-debug.log

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*~
.~*

# System files
.AppleDouble
.LSOverride
Icon?
.TemporaryItems
.Trashes
.VolumeIcon.icns
.fseventsd
.AppleDB
.spotlight-V100

# Windows Specific
desktop.ini
$RECYCLE.BIN/

# Build outputs
.build/
build/
dist/

# Documentation builds
site/
_build/
docs/_build/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Personal notes
notes/
personal/
TODO.md
NOTES.md

# Large files
*.tar.gz
*.zip
*.rar
